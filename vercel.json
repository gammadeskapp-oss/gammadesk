{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/log/snapshot",
      "schedule": "45 14 * * 1-5"
    },
    {
      "path": "/api/log/settle",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/groups/refresh",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/digest",
      "schedule": "20 22 * * 1-5"
    },
    {
      "path": "/api/flow/refresh",
      "schedule": "40 21 * * 1-5"
    }
  ]
}
