{
  "name": "gammadesk",
  "version": "1.0.0",
  "private": true,
  "description": "GammaDesk — SPY options dealer-positioning dashboard (GEX / VEX / CEX / OI)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/generate-brand.mjs",
    "verify:greeks": "node scripts/verify-greeks.js",
    "verify:indicators": "node scripts/verify-indicators.js",
    "verify:simulation": "node scripts/verify-simulation.js",
    "verify:rs": "node scripts/verify-rs.js",
    "verify:netliq": "node scripts/verify-netliq.mjs",
    "verify:nw": "node scripts/verify-nw.mjs",
    "verify:profile": "node scripts/verify-profile.mjs",
    "verify:levelmap": "node scripts/verify-levelmap.mjs",
    "verify:regime": "node scripts/verify-regime.mjs",
    "verify:retests": "node scripts/verify-retests.mjs",
    "verify:staleness": "node scripts/verify-staleness.mjs",
    "verify:context": "node scripts/verify-context.mjs",
    "verify:events": "node scripts/verify-events.mjs",
    "verify": "npm run verify:greeks && npm run verify:indicators && npm run verify:simulation && npm run verify:rs && npm run verify:netliq && npm run verify:nw && npm run verify:profile && npm run verify:levelmap && npm run verify:regime && npm run verify:retests && npm run verify:staleness && npm run verify:context && npm run verify:events"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "lightweight-charts": "^5.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
