# ---------------------------------------------------------------------------
# GammaDesk environment variables
# Copy this file to `.env.local` and fill in your key. `.env.local` is
# git-ignored and is NEVER sent to the browser.
# ---------------------------------------------------------------------------

# Where the option chain comes from.
#   cboe    = Cboe delayed quotes (DEFAULT). Free, needs no key, one request
#             per refresh, and includes open interest and implied volatility.
#   polygon = Polygon.io. Requires POLYGON_API_KEY *and* a paid options plan:
#             the free plan returns 403 for the options snapshot endpoint, and
#             exposes no open interest at all, so the dashboard cannot work.
GAMMADESK_DATA_SOURCE=cboe

# Only needed when GAMMADESK_DATA_SOURCE=polygon. Server-side only.
POLYGON_API_KEY=

# OPTIONAL — everything below has a sensible default.

# Underlying symbol to analyse.
GAMMADESK_SYMBOL=SPY

# How long (seconds) to cache one upstream refresh. Default 1800 = 30 minutes.
# Keep this high on Polygon's free plan, which allows 5 requests/minute.
GAMMADESK_CACHE_SECONDS=1800

# Number of expirations shown as columns.
GAMMADESK_EXPIRATIONS=5

# Number of strikes shown above and below spot.
GAMMADESK_STRIKES_EACH_SIDE=30

# Annualised risk-free rate and dividend yield used by Black-Scholes.
GAMMADESK_RISK_FREE_RATE=0.043
GAMMADESK_DIVIDEND_YIELD=0.012

# OPTIONAL — the morning scanner (/scanner).
#
# Nothing here needs setting; the defaults are the ones the page ships with.
# The Nadaraya-Watson settings are the exception worth knowing about: set them
# to whatever your own chart uses, or the scanner's NW column and your chart
# will disagree and the column is worse than useless.

# Composite relative-strength score a name must clear to be a candidate. This
# gates the whole pipeline — only names above it get a same-day gamma refresh
# or have bars pulled — so raising it makes both jobs smaller.
#
# Do not read this as a percentile. The score is a weighted mean of three
# window percentiles, and a mean of weakly-correlated percentiles concentrates
# toward the middle, so far fewer names clear a given number than "top decile"
# intuition suggests. Measured against the S&P 500: 90 gives 27 candidates,
# 84 gives 39, 82 gives 50, 80 gives 58. Since Cboe answers only about sixty
# chains per window, 80 would already leave part of the list unrefreshed.
# Check any new value with ?dry=1 on /api/scanner/gamma first.
GAMMADESK_SCAN_RS_MIN=82

# New York wall-clock times the two jobs are scheduled for, HH:MM. These are
# what the page states and what the routes check themselves against; the actual
# triggers are the cron entries in vercel.json, which cannot read these. Move
# one and you must move both.
GAMMADESK_SCAN_GAMMA_TIME_ET=08:30
GAMMADESK_SCAN_TIME_ET=09:35

# Chains the 08:30 job may request. Cboe answers roughly sixty per window and
# then refuses, and that is a quota rather than a rate — a slower job does not
# get more. Past this the run stops and reports what it did not reach.
GAMMADESK_SCAN_GAMMA_BUDGET=55

# What each timeframe's anchored VWAP resets on: session or week. A session
# anchor on a daily series is meaningless, since every daily bar is its own
# session.
GAMMADESK_SCAN_VWAP_1H=session
GAMMADESK_SCAN_VWAP_4H=week
GAMMADESK_SCAN_VWAP_1D=week

# The trend EMA price must sit above (filter 7).
GAMMADESK_SCAN_TREND_EMA=200

# Nadaraya-Watson envelope: Gaussian bandwidth, lookback in bars, and the
# multiple of mean absolute error the band sits at. Defaults match the common
# non-repainting TradingView envelope. `npm run verify:nw` prints SPY's current
# reading at these settings so you can compare it against your chart.
GAMMADESK_SCAN_NW_H=8
GAMMADESK_SCAN_NW_LOOKBACK=499
GAMMADESK_SCAN_NW_MULT=3

# Fewest bars that produce an NW reading at all. Below this the timeframe is
# marked unknown and the ticker excluded — never marked as below the band.
GAMMADESK_SCAN_NW_MIN_BARS=120

# Days of finished scans kept, so a missed morning is still readable.
GAMMADESK_SCAN_KEEP_DAYS=5

# Bar series fetched at once during a scan, and the wall-clock backstop for
# that phase in milliseconds.
GAMMADESK_SCAN_BAR_CONCURRENCY=6
GAMMADESK_SCAN_BAR_BUDGET_MS=220000

# OPTIONAL — Discord webhook the daily digest is posted to. Treat it as a
# credential: anyone holding it can post to that channel. Server-side only.
# Leave empty to generate the digest without delivering it anywhere.
# ---------------------------------------------------------------------------
# Tradier — batch quotes and one-minute bars
# ---------------------------------------------------------------------------
#
# Optional. Used by two features only: the breadth meter on /decision and
# /scanner, and the level event feed under the chart.
#
# It is worth having. Tradier answers the whole 500-symbol S&P universe in a
# single request in about a tenth of a second, and its time-and-sales endpoint
# returns one-minute bars carrying a volume-weighted average price. Both
# features fall back to Yahoo without it — the breadth sweep becomes 26
# requests instead of 1, and the average price for the day is derived from bars
# rather than read from the feed, which the page states.
#
# Note that the advance/decline and tick index feeds ($ADD, $TICK) are NOT
# available from Tradier, Polygon or Yahoo. That is why breadth is computed
# from constituents rather than read from an index.
#
# A free Tradier account provides delayed market data. Sign up at
# tradier.com and take the token from the API access section.
TRADIER_TOKEN=

DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Private pages — off unless switched on
# ---------------------------------------------------------------------------
#
# Two pages 404 unless their variable is set to `1` or `true`. Anything else,
# including unset, empty, `0` and `false`, leaves them not existing — for the
# page and for the endpoints under it alike.
#
# Off is the correct production setting for both. They are unlisted research
# pages, and unlisted is not private: without a gate, anybody who types the URL
# reads them. The gate is a switch and not authentication — it keeps a feature
# from shipping with whatever deploy happens to contain it. See
# `src/lib/pageFlag.ts`.
#
# Separate variables on purpose. The pages are unrelated, and one switch
# covering both would mean turning on the ranking testbed also republished a
# superseded scanner.
#
# /lab — a ranked blend of six existing readings over the whole index, at
# weights you set. A testbed: nothing on it has been validated. It also reads
# live prices when TRADIER_TOKEN is set, which is another reason it has no
# business being reachable in production.
GAMMADESK_LAB=

# /previousscanner — the earlier seven-gate scanner build, restored unchanged
# including the parts that did not work. Note that a page view triggers its
# scan when today's document is missing, so the gate also stops a stray
# production request starting a run.
GAMMADESK_LEGACY_SCANNER=
